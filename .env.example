# Private runtimeConfig (Nitro / server only). Never prefix with NUXT_PUBLIC_.
# Leave empty locally; the BFF falls back to in-process seed data.
NUXT_UPSTREAM_API_TOKEN=
NUXT_UPSTREAM_CATALOG_URL=

# Public runtimeConfig (sent to the browser). Safe, non-secret values only.
NUXT_PUBLIC_APP_NAME=Nuxt Layered Guide
